---
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts'))
  .filter((post) => post.data.category === 'study')
  .sort((a, b) => a.data.publishedAt.getTime() - b.data.publishedAt.getTime());
const series = Object.entries(posts.reduce<Record<string, typeof posts>>((groups, post) => {
  const name = post.data.series?.trim() || 'independent-notes';
  (groups[name] ??= []).push(post);
  return groups;
}, {})).sort(([a], [b]) => a.localeCompare(b));
const currentPath = Astro.url.pathname;
---

<div class="tree-content">
  <p class="tree-help">&quot; Press ? for help</p>
  <a class:list={['tree-root', { current: currentPath === '/study/' }]} href="/study/" aria-current={currentPath === '/study/' ? 'page' : undefined}>▾ study/</a>
  {series.length === 0 ? (
    <p class="tree-empty">└─ (no study series yet)</p>
  ) : series.map(([name, entries]) => (
    <details class="tree-series" open>
      <summary>{name}/</summary>
      <ul>
        {entries.map((post) => {
          const href = `/posts/${post.id.replace(/\.md$/, '')}/`;
          return <li><a class:list={{ current: currentPath === href }} href={href} aria-current={currentPath === href ? 'page' : undefined}>└─ {post.data.title}</a></li>;
        })}
      </ul>
    </details>
  ))}
</div>

<style>
  .tree-content { font-size: 0.76rem; line-height: 1.6; min-width: 0; }
  .tree-help { border-bottom: 1px solid var(--border); color: var(--muted); margin: 0 0 0.45rem; padding: 0 0 0.45rem; }
  .tree-root, summary { color: var(--foreground); text-decoration: none; }
  .tree-root { display: block; padding: 0.1rem 0; }
  .tree-series { margin: 0.1rem 0; }
  summary { cursor: pointer; list-style: none; padding: 0.1rem 0; }
  summary::-webkit-details-marker { display: none; }
  summary::before { color: var(--accent); content: '▾ '; }
  details:not([open]) summary::before { content: '▸ '; }
  ul { list-style: none; margin: 0; padding: 0 0 0 1ch; }
  li { margin: 0.08rem 0; }
  li a { display: block; overflow: hidden; padding: 0.08rem 0; text-decoration: none; text-overflow: ellipsis; white-space: nowrap; }
  .current { background: var(--selection); color: var(--accent); font-weight: 700; }
  .tree-empty { color: var(--muted); margin: 0.35rem 0 0; padding-left: 1ch; }
  a:focus-visible, summary:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
</style>
