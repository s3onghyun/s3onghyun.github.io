---
import '../styles/global.css';
import { siteConfig } from '../config/site';
import { themeInitScript } from '../lib/theme-init.js';

interface Props {
  description?: string;
  lang?: 'ko' | 'en';
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  title?: string;
}

const {
  description = 'Platform / DevOps engineer의 기술 노트',
  lang = 'ko',
  structuredData,
  title = 'SEONGHYUN HONG',
} = Astro.props;
const pageTitle = title === 'SEONGHYUN HONG' ? title : `${title} | SEONGHYUN HONG`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(siteConfig.defaultOgImage, Astro.site);
const jsonLd = structuredData && JSON.stringify(structuredData).replaceAll('<', '\\u003c');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f6ef" />
    <script is:inline set:html={themeInitScript}></script>
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title="SEONGHYUN HONG" href="/rss.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    {siteConfig.verification.google && <meta name="google-site-verification" content={siteConfig.verification.google} />}
    {siteConfig.verification.naver && <meta name="naver-site-verification" content={siteConfig.verification.naver} />}
    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&amp;family=Noto+Sans+Symbols+2&amp;display=swap" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/wan2land/d2coding/d2coding-full.css" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <a class="site-name" href="/">s3onghyun@notes:~$</a>
        <nav aria-label="Primary navigation">
          <a href="/posts/">posts</a>
          <a href="/tech/">tech</a>
          <a href="/study/">study</a>
          <a href="/life/">life</a>
          <a href="/tags/">tags</a>
          <a href="/projects/">projects</a>
          <a href="/about/">about</a>
        </nav>
        <button class="theme-toggle" type="button" aria-label="Switch color scheme" title="Switch color scheme">
          <span aria-hidden="true">:colorscheme </span><span data-theme-label>paper</span>
        </button>
      </header>
      <main><slot /></main>
      <footer class="site-footer">© {new Date().getFullYear()} SEONGHYUN HONG <span aria-hidden="true">·</span> press j / k to scroll</footer>
    </div>
    <script>
      const themeStorageKey = 's3onghyun-theme';
      const themeToggle = document.querySelector<HTMLButtonElement>('.theme-toggle');
      const themeLabel = document.querySelector<HTMLElement>('[data-theme-label]');
      const setTheme = (theme: 'paper' | 'night', persist = false) => {
        document.documentElement.dataset.theme = theme;
        document.querySelector('meta[name="theme-color"]')?.setAttribute('content', theme === 'night' ? '#1d2021' : '#f7f6ef');
        if (themeLabel) themeLabel.textContent = theme;
        if (themeToggle) themeToggle.setAttribute('aria-label', `Switch color scheme; current scheme: ${theme}`);
        if (persist) {
          try {
            window.localStorage.setItem(themeStorageKey, theme);
          } catch {
            // Keep the choice for this page when storage is unavailable.
          }
        }
      };

      setTheme(document.documentElement.dataset.theme === 'night' ? 'night' : 'paper');
      themeToggle?.addEventListener('click', () => {
        const nextTheme = document.documentElement.dataset.theme === 'night' ? 'paper' : 'night';
        setTheme(nextTheme, true);
      });

      document.addEventListener('keydown', (event) => {
        const target = event.target as HTMLElement | null;
        if (event.defaultPrevented || event.metaKey || event.ctrlKey || event.altKey || target?.matches('input, textarea, select, [contenteditable]')) return;
        if (event.key === 'j' || event.key === 'k') {
          window.scrollBy({ top: window.innerHeight * (event.key === 'j' ? 0.7 : -0.7), behavior: 'smooth' });
        }
      });
    </script>
  </body>
</html>
