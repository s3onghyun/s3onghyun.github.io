---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  const tags = [...new Set(posts.flatMap((post) => post.data.tags))];

  return tags.map((tag) => ({
    params: { tag },
    props: {
      tag,
      posts: posts
        .filter((post) => post.data.tags.includes(tag))
        .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime()),
    },
  }));
}

interface Props {
  tag: string;
  posts: CollectionEntry<'posts'>[];
}

const { tag, posts } = Astro.props;
const dateFormatter = new Intl.DateTimeFormat('ko-KR', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
});
---

<BaseLayout title={`#${tag}`} description={`${tag} 태그의 기술 노트 초안`}>
  <section class="tag-archive">
    <p class="command"><span aria-hidden="true">$ </span>rg --files --glob '*{tag}*' ~/notes/posts</p>
    <p class="eyebrow">tag:</p>
    <h1>#{tag}</h1>
    <p class="notice">{posts.length} draft note{posts.length === 1 ? '' : 's'} based on public material</p>
    <ol>
      {posts.map((post, index) => (
        <li>
          <span class="line-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <article>
            <div class="post-meta">
              <time datetime={post.data.publishedAt.toISOString()}>{dateFormatter.format(post.data.publishedAt)}</time>
              {post.data.draft && <span class="draft">DRAFT</span>}
            </div>
            <h2><a href={`/posts/${post.id.replace(/\.md$/, '')}/`}>{post.data.title}</a></h2>
            <p>{post.data.description}</p>
          </article>
        </li>
      ))}
    </ol>
    <p><a class="back" href="/posts/">← back to posts</a></p>
    <p class="modeline" aria-hidden="true">-- TAG -- #{tag} · {posts.length} drafts</p>
  </section>
</BaseLayout>

<style>
  .tag-archive { padding-top: clamp(2.5rem, 8vw, 5rem); }
  .command { color: var(--accent); font-size: 0.9rem; }
  .eyebrow { color: var(--muted); font-size: 0.8rem; margin: 1rem 0 0; }
  h1 { margin: 0.1rem 0 0.75rem; font-size: clamp(1.7rem, 5vw, 2.4rem); }
  .notice { color: var(--muted); margin: 0 0 1.75rem; }
  ol { list-style: none; margin: 0; padding: 0; }
  ol > li { border-top: 1px solid var(--border); display: grid; gap: 1rem; grid-template-columns: 2ch 1fr; padding: 1.25rem 0; }
  ol > li:last-child { border-bottom: 1px solid var(--border); }
  .line-number { color: var(--border); font-size: 0.82rem; padding-top: 0.2rem; }
  .post-meta { align-items: center; color: var(--muted); display: flex; font-size: 0.78rem; gap: 0.75rem; }
  h2 { font-size: 1.05rem; line-height: 1.55; margin: 0.35rem 0; }
  article > p { color: var(--muted); margin: 0; }
  .draft { border: 1px solid var(--border); color: var(--accent); font-size: 0.7rem; padding: 0.05rem 0.3rem; }
  .back { color: var(--accent); font-size: 0.85rem; }
  .modeline { background: var(--surface); color: var(--muted); font-size: 0.76rem; margin-top: 2rem; padding: 0.2rem 0.5rem; text-align: right; }
</style>
