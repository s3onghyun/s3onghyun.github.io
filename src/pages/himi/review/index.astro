---
// Unlisted App Review page: standalone (no BaseLayout) so it stays out of nav and carries noindex.
const video = '/himi/review/himi-review.mp4';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>HIMI — App Review screen recording</title>
    <style>
      body { font-family: system-ui, sans-serif; max-width: 720px; margin: 2rem auto; padding: 0 1rem; }
      video { width: 100%; max-height: 80vh; background: #000; }
    </style>
  </head>
  <body>
    <h1>HIMI — App Review screen recording</h1>
    <video controls playsinline preload="metadata" src={video}></video>
    <p><a href={video}>Download / open the MP4 directly</a></p>
    <p>Recorded on iPhone 11 Pro (iOS 27.2.1), build 1.0 (4)</p>
  </body>
</html>
