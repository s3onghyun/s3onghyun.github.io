---
import { getCollection } from 'astro:content';
import CategoryArchive from '../components/CategoryArchive.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('posts'))
  .filter((post) => post.data.category === 'study')
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
---

<BaseLayout title="Study" description="Study notes, grouped by series.">
  <CategoryArchive category="study" description="Algorithms, Go, and other notes grouped by series." {posts} />
</BaseLayout>
