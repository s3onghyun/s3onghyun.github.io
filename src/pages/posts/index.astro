---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);

const dateFormatter = new Intl.DateTimeFormat('ko-KR', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
});
---

<BaseLayout title="Posts" description="s3onghyun의 기술 노트 초안 목록">
  <section class="posts">
    <p class="command"><span aria-hidden="true">$ </span>ls ~/notes/posts</p>
    <h1>posts/</h1>
    <p class="notice">공개 자료를 바탕으로 작성 중인 초안입니다.</p>
    <ol>
      {posts.map((post, index) => (
        <li>
          <span class="line-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <article>
            <div class="post-meta">
              <time datetime={post.data.publishedAt.toISOString()}>
                {dateFormatter.format(post.data.publishedAt)}
              </time>
              {post.data.draft && <span class="draft">DRAFT</span>}
            </div>
            <h2>{post.data.title}</h2>
            <p>{post.data.description}</p>
            <ul class="tags" aria-label="태그">
              {post.data.tags.map((tag) => <li>#{tag}</li>)}
            </ul>
          </article>
        </li>
      ))}
    </ol>
    <p class="modeline" aria-hidden="true">-- POSTS -- {posts.length} drafts</p>
  </section>
</BaseLayout>

<style>
  .posts { padding-top: clamp(2.5rem, 8vw, 5rem); }
  .command { color: var(--accent); font-size: 0.9rem; }
  h1 { margin: 1rem 0 0.75rem; font-size: clamp(1.7rem, 5vw, 2.4rem); }
  .notice { color: var(--muted); margin: 0 0 1.75rem; }
  ol { list-style: none; margin: 0; padding: 0; }
  ol > li { border-top: 1px solid var(--border); display: grid; gap: 1rem; grid-template-columns: 2ch 1fr; padding: 1.25rem 0; }
  ol > li:last-child { border-bottom: 1px solid var(--border); }
  .line-number { color: var(--border); font-size: 0.82rem; padding-top: 0.2rem; }
  .post-meta { align-items: center; color: var(--muted); display: flex; font-size: 0.78rem; gap: 0.75rem; }
  h2 { font-size: 1.05rem; line-height: 1.55; margin: 0.35rem 0; }
  article > p { color: var(--muted); margin: 0; }
  .draft { border: 1px solid var(--border); color: var(--accent); font-size: 0.7rem; padding: 0.05rem 0.3rem; }
  .tags { display: flex; flex-wrap: wrap; gap: 0.5rem; list-style: none; margin: 0.75rem 0 0; padding: 0; }
  .tags li { color: var(--accent); font-size: 0.78rem; }
  .modeline { background: var(--surface); color: var(--muted); font-size: 0.76rem; margin-top: 2rem; padding: 0.2rem 0.5rem; text-align: right; }
</style>
