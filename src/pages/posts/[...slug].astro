---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');

  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.md$/, '') },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { Content } = await post.render();
const dateFormatter = new Intl.DateTimeFormat('ko-KR', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
});
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="post">
    <p class="command"><span aria-hidden="true">$ </span>cat ~/notes/posts/{post.id}.md</p>
    <header>
      <p class="post-meta">
        <time datetime={post.data.publishedAt.toISOString()}>{dateFormatter.format(post.data.publishedAt)}</time>
        {post.data.draft && <span class="draft">DRAFT</span>}
      </p>
      <h1>{post.data.title}</h1>
      <p class="description">{post.data.description}</p>
      <ul class="tags" aria-label="태그">
        {post.data.tags.map((tag) => <li><a href={`/tags/${encodeURIComponent(tag)}/`}>#{tag}</a></li>)}
      </ul>
    </header>
    <div class="prose"><Content /></div>
    <p class="modeline" aria-hidden="true">-- DRAFT -- {post.id}.md</p>
  </article>
</BaseLayout>

<style>
  .post { padding-top: clamp(2.5rem, 8vw, 5rem); }
  .command { color: var(--accent); font-size: 0.9rem; }
  header { border-bottom: 1px solid var(--border); padding-bottom: 1.5rem; }
  .post-meta { align-items: center; color: var(--muted); display: flex; font-size: 0.78rem; gap: 0.75rem; margin: 1rem 0 0; }
  h1 { font-size: clamp(1.7rem, 5vw, 2.4rem); line-height: 1.45; margin: 0.55rem 0; }
  .description { color: var(--muted); margin: 0; }
  .draft { border: 1px solid var(--border); color: var(--accent); font-size: 0.7rem; padding: 0.05rem 0.3rem; }
  .tags { display: flex; flex-wrap: wrap; gap: 0.5rem; list-style: none; margin: 1rem 0 0; padding: 0; }
  .tags li { color: var(--accent); font-size: 0.78rem; }
  .prose { margin-top: 2rem; }
  .prose :global(h1) { display: none; }
  .prose :global(h2) { font-size: 1.25rem; margin-top: 2.25rem; }
  .prose :global(a) { color: var(--accent); }
  .prose :global(code) { background: var(--surface); color: var(--accent); padding: 0.1em 0.3em; }
  .prose :global(pre) { background: var(--surface); border: 1px solid var(--border); overflow-x: auto; padding: 1rem; }
  .prose :global(pre code) { padding: 0; }
  .modeline { background: var(--surface); color: var(--muted); font-size: 0.76rem; margin-top: 3rem; padding: 0.2rem 0.5rem; text-align: right; }
</style>
