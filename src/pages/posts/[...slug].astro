---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StudyLayout from '../../components/StudyLayout.astro';
import { postJsonLd } from '../../lib/seo';
import { postMarkdownUrl, postUrl, relatedPosts } from '../../lib/content';

export async function getStaticPaths() {
  const posts = await getCollection('posts');

  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.md$/, '') },
    props: { post, related: relatedPosts(post, posts) },
  }));
}

interface Props {
  post: CollectionEntry<'posts'>;
  related: CollectionEntry<'posts'>[];
}

const { post, related } = Astro.props;
const { Content } = await post.render();
const dateFormatter = new Intl.DateTimeFormat('ko-KR', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
});
---

<BaseLayout title={post.data.title} description={post.data.description} lang={post.data.language} structuredData={postJsonLd(post)} markdownUrl={postMarkdownUrl(post)}>
  <StudyLayout enabled={post.data.category === 'study'}>
  <article class="post">
    <p class="command"><span aria-hidden="true">$ </span>cat ~/notes/posts/{post.id}</p>
    <header>
      <p class="post-meta">
        <time datetime={post.data.publishedAt.toISOString()}>{dateFormatter.format(post.data.publishedAt)}</time>
        {post.data.draft && <span class="draft">DRAFT</span>}
      </p>
      <h1>{post.data.title}</h1>
      <p class="description">{post.data.description}</p>
      <ul class="tags" aria-label="Tags">
        {post.data.tags.map((tag) => <li><a href={`/tags/${encodeURIComponent(tag)}/`}>#{tag}</a></li>)}
      </ul>
    </header>
    {(post.data.summary || post.data.appliesTo || post.data.testedWith?.length || post.data.updatedAt || post.data.publishedAt) && <section class="citation-box" aria-label="Post verification details">
      {post.data.summary && <p><strong>결론</strong> {post.data.summary}</p>}
      {(post.data.appliesTo || post.data.testedWith?.length) && <p><strong>적용</strong> {[post.data.appliesTo, post.data.testedWith?.join(', ')].filter(Boolean).join(' · ')}</p>}
      <p><strong>확인일</strong> <time datetime={(post.data.updatedAt ?? post.data.publishedAt).toISOString()}>{dateFormatter.format(post.data.updatedAt ?? post.data.publishedAt)}</time></p>
    </section>}
    <div class="prose"><Content /></div>
    {post.data.sources?.length && <section class="sources" aria-labelledby="sources-heading">
      <h2 id="sources-heading">Sources</h2>
      <ul>{post.data.sources.map((source) => <li><a href={source.url}>{source.title}</a></li>)}</ul>
    </section>}
    {related.length > 0 && <nav class="related" aria-labelledby="related-heading">
      <h2 id="related-heading">Related posts</h2>
      <ul>{related.map((other) => <li><a href={postUrl(other)}>{other.data.title}</a> <span>{other.data.description}</span></li>)}</ul>
    </nav>}
    <p class="modeline" aria-hidden="true">-- DRAFT -- {post.id}.md</p>
  </article>
  </StudyLayout>
</BaseLayout>

<style>
  .post { padding-top: clamp(2.5rem, 8vw, 5rem); }
  .command { color: var(--accent); font-size: 0.9rem; }
  header { border-bottom: 1px solid var(--border); padding-bottom: 1.5rem; }
  .post-meta { align-items: center; color: var(--muted); display: flex; font-size: 0.78rem; gap: 0.75rem; margin: 1rem 0 0; }
  h1 { font-size: clamp(1.7rem, 5vw, 2.4rem); line-height: 1.45; margin: 0.55rem 0; }
  .description { color: var(--muted); margin: 0; }
  .draft { border: 1px solid var(--border); color: var(--accent); font-size: 0.7rem; padding: 0.05rem 0.3rem; }
  .tags { display: flex; flex-wrap: wrap; gap: 0.5rem; list-style: none; margin: 1rem 0 0; padding: 0; }
  .tags li { color: var(--accent); font-size: 0.78rem; }
  .prose { margin-top: 2rem; }
  .citation-box { background: var(--surface); border: 1px solid var(--border); font-size: 0.9rem; margin-top: 1.5rem; padding: 0.85rem 1rem; }
  .citation-box::before { color: var(--accent); content: '$ post --verification'; display: block; font-size: 0.78rem; margin-bottom: 0.55rem; }
  .citation-box p { margin: 0.35rem 0; }
  .citation-box strong { color: var(--accent); display: inline-block; min-width: 4rem; }
  .sources { border-top: 1px dashed var(--border); margin-top: 2.5rem; padding-top: 1.25rem; }
  .sources h2 { font-size: 1.1rem; }
  .sources a { color: var(--accent); }
  .related { border-top: 1px dashed var(--border); margin-top: 2.5rem; padding-top: 1.25rem; }
  .related::before { color: var(--accent); content: '$ grep -l --tags ~/notes/posts'; display: block; font-size: 0.78rem; margin-bottom: 0.55rem; }
  .related h2 { font-size: 1.1rem; margin-top: 0; }
  .related ul { list-style: none; margin: 0; padding: 0; }
  .related li { margin: 0.5rem 0; }
  .related li::before { color: var(--muted); content: '> '; }
  .related a { color: var(--accent); }
  .related span { color: var(--muted); display: block; font-size: 0.85rem; padding-left: 1.2rem; }
  .prose :global(h1) { display: none; }
  .prose :global(h2) { font-size: 1.25rem; margin-top: 2.25rem; }
  .prose :global(a) { color: var(--accent); }
  .prose :global(code) { background: var(--surface); border: 1px solid color-mix(in srgb, var(--border) 65%, transparent); border-radius: 0.15rem; color: var(--accent); padding: 0.1em 0.3em; }
  .prose :global(pre) { background: var(--surface); border: 1px solid var(--border); border-radius: 0.2rem; line-height: 1.65; overflow-x: auto; padding: 1rem; }
  .prose :global(pre code) { background: transparent; border: 0; color: inherit; padding: 0; }
  .prose :global(blockquote) { background: color-mix(in srgb, var(--surface) 82%, var(--accent) 18%); border-left: 0.3rem solid var(--accent); color: var(--quote-text); margin: 1.5rem 0; padding: 0.8rem 1rem 0.8rem 2.35rem; position: relative; }
  .prose :global(blockquote::before) { color: var(--accent); content: ">"; font-weight: 700; left: 0.85rem; position: absolute; }
  .prose :global(blockquote > :first-child) { margin-top: 0; }
  .prose :global(blockquote > :last-child) { margin-bottom: 0; }
  .prose :global(table) { border: 1px solid var(--border); border-collapse: collapse; display: block; margin: 1.5rem 0; max-width: 100%; overflow-x: auto; width: max-content; }
  .prose :global(th), .prose :global(td) { border: 1px solid var(--border); padding: 0.55rem 0.8rem; text-align: left; vertical-align: top; }
  .prose :global(th) { background: color-mix(in srgb, var(--surface) 72%, var(--accent) 28%); color: var(--foreground); font-weight: 700; }
  .prose :global(tbody tr:nth-child(even)) { background: color-mix(in srgb, var(--surface) 78%, transparent); }
  .prose :global(hr) { border: 0; border-top: 1px dashed var(--border); margin: 2.5rem 0; }
  .prose :global(ul:has(input[type="checkbox"])) { list-style: none; padding-left: 0; }
  .prose :global(input[type="checkbox"]) { accent-color: var(--accent); margin: 0 0.55rem 0 0; }
  .prose :global(input[type="checkbox"]:checked) { filter: none; }
  .modeline { background: var(--surface); color: var(--muted); font-size: 0.76rem; margin-top: 3rem; padding: 0.2rem 0.5rem; text-align: right; }

  @media (max-width: 30rem) {
    .prose :global(th), .prose :global(td) { padding: 0.45rem 0.65rem; }
  }
</style>
