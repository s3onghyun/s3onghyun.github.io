---
import { getCollection } from 'astro:content';
import CategoryArchive from '../components/CategoryArchive.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('posts'))
  .filter((post) => post.data.category === 'life')
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
---

<BaseLayout title="Life" description="Books and escape-room notes.">
  <CategoryArchive category="life" description="Books, escape rooms, and personal keepsakes." {posts} />
</BaseLayout>
